{
    "compilerOptions": {
        "paths": {
            "@/*": ["./src/*"],
            "@components/*": ["./src/components/*"],
            "@pages/*": ["./src/pages/*"],
            "@hooks/*": ["./src/hooks/*"],
            "@utils/*": ["./src/utils/*"],
            "@assets/*": ["./src/assets/*"],
            "@css/*": ["./src/css/*"],
            "@mock/*": ["./src/mock/*"]
        }
    },
    "exclude": ["node_modules", "dist"]
}
